# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Local development (SQLite) ───────────────────────────────────────────────
# The path resolves relative to prisma/schema.prisma, so `file:../db/custom.db`
# points at <project-root>/db/custom.db. `npm run db:push` creates the folder
# and file for you. Tip: an absolute path (file:/full/path/to/db/custom.db)
# is the most bulletproof option if your editor/server starts elsewhere.
DATABASE_URL=file:../db/custom.db

# ── Production (Vercel + Vercel Postgres / Neon) ─────────────────────────────
# Do NOT put this in .env for local dev — set it as an environment variable in
# Vercel (Project → Settings → Environment Variables) or in the Vercel
# dashboard's Storage → Postgres integration, which wires it automatically.
# Use the POOLED connection string for serverless:
#
# DATABASE_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
#
# Then push the schema and seed once from your machine (see README.md →
# "Initialize the production database").
